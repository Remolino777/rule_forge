  "rules": [
    {
      "rule_id": "K01-STAIR-TOP-ARRIVAL",
      "kind": "client",
      "magnitude": "stair_top_receiving_space",
      "operator": "in",
      "value": null,
      "unit": null,
      "parameters": {
        "default": "hall",
        "small_house": "upper_vestibule",
        "max": "family_room",
        "allowed": [
          "hall",
          "upper_vestibule",
          "family_room"
        ],
        "forbidden": [
          "bedroom",
          "primary_suite",
          "flex_room",
          "study",
          "primary_bath",
          "bathroom",
          "walk_in_closet",
          "closet",
          "laundry",
          "laundry_closet"
        ],
        "as_preference": {
          "order_small_house": [
            "upper_vestibule",
            "hall",
            "family_room"
          ],
          "order_default": [
            "hall",
            "upper_vestibule",
            "family_room"
          ],
          "decided": "2026-10-10: the receiving space among the allowed ones is a preference (scored); arriving into a forbidden space is never allowed."
        }
      },
      "text": [
        "The stair never arrives directly into a room upstairs: it arrives into a hall; in small houses into a vestibule; at most into a family room."
      ],
      "source": {
        "document": "Client decisions",
        "section": "2026-10-09, stair arrival"
      },
      "verified": true
    },
    {
      "rule_id": "K02-STAIR-BOTTOM-START",
      "kind": "client",
      "magnitude": "stair_bottom_receiving_space",
      "operator": "in",
      "value": null,
      "unit": null,
      "parameters": {
        "options": [
          {
            "option": "A",
            "label": "vestibulated",
            "receiving": [
              "foyer",
              "hall"
            ]
          },
          {
            "option": "B",
            "label": "living",
            "receiving": [
              "living_room",
              "living_dining",
              "family_room"
            ]
          },
          {
            "option": "C",
            "label": "kitchen",
            "receiving": [
              "kitchen",
              "dining_room",
              "breakfast_nook"
            ]
          }
        ],
        "forbidden": [
          "garage_1car",
          "garage_2car",
          "garage_2car_tandem",
          "bedroom",
          "primary_suite",
          "primary_bath",
          "bathroom",
          "laundry",
          "laundry_closet"
        ]
      },
      "text": [
        "Downstairs the stair starts vestibulated to a circulation, from the living room or, as a third option always available, from the kitchen; never from the garage, a bedroom, a bathroom or the laundry."
      ],
      "source": {
        "document": "Client decisions",
        "section": "2026-10-09, stair start"
      },
      "verified": true
    },
    {
      "rule_id": "K03-UNDER-STAIR-KITCHEN",
      "kind": "client",
      "magnitude": "under_stair_use",
      "operator": "in",
      "value": null,
      "unit": null,
      "parameters": {
        "opens_to": [
          "kitchen",
          "dining_room",
          "breakfast_nook"
        ],
        "uses": [
          "storage",
          "pantry"
        ]
      },
      "text": [
        "If the space under the stair opens toward the kitchen it is storage only, never a half bath.",
        "2026-10-14 (V6.8 k1b): kept as the kitchen case of K13 (toward the kitchen: storage, pantry)."
      ],
      "source": {
        "document": "Client decisions",
        "section": "2026-10-09, under-stair space"
      },
      "verified": true
    },
    {
      "rule_id": "K04-HALF-BATH-VESTIBULE",
      "kind": "client",
      "magnitude": "half_bath_door",
      "operator": "in",
      "value": null,
      "unit": null,
      "parameters": {
        "space_types": [
          "half_bath"
        ],
        "door_to_allowed": [
          "foyer",
          "hall",
          "vestibule"
        ],
        "door_to_forbidden": [
          "living_room",
          "living_dining",
          "family_room",
          "dining_room",
          "kitchen",
          "breakfast_nook"
        ]
      },
      "text": [
        "A half bath is always vestibulated: its door opens to a circulation, never directly to a living room or a kitchen."
      ],
      "source": {
        "document": "Client decisions",
        "section": "2026-10-09, half bath"
      },
      "verified": true
    },
    {
      "rule_id": "K13-UNDER-STAIR-USE",
      "kind": "client",
      "magnitude": "under_stair_use",
      "operator": "in",
      "value": null,
      "unit": null,
      "parameters": {
        "half_bath_opens_to": [
          "foyer",
          "hall"
        ],
        "otherwise": "pantry",
        "zoning_use": "storage",
        "half_bath_beside_stair": false,
        "through_vestibule_to_living": false,
        "decided": "2026-10-14 12:47 (V6.8 k1b): the half bath goes under the stair only when that space opens to the foyer or a hall and the half bath fits; in any other case the space under the stair is a pantry (the variant through a vestibule toward the living room is removed). The half bath never stands beside the stair: when it is not under the stair, S2.1 places it in the circulation like any other space."
      },
      "text": [
        "The space under the stair holds the half bath only when it opens to the foyer or a hall and the half bath fits; otherwise it is a pantry (K03, toward the kitchen, is the same case). The half bath is never placed beside the stair."
      ],
      "source": {
        "document": "Client decisions",
        "section": "2026-10-14 12:47, under-stair space (V6.8 k1b)"
      },
      "verified": true
    },
