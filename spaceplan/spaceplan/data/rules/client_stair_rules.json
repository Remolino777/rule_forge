      "kind": "client",
      "magnitude": "half_bath_door",
      "operator": "in",
      "value": null,
      "unit": null,
      "parameters": {
        "space_types": [
          "half_bath"
        ],
        "door_to_allowed": [
          "foyer",
          "hall",
          "vestibule"
        ],
        "door_to_forbidden": [
          "living_room",
          "living_dining",
          "family_room",
          "dining_room",
          "kitchen",
          "breakfast_nook"
        ]
      },
      "text": [
        "A half bath is always vestibulated: its door opens to a circulation, never directly to a living room or a kitchen."
      ],
      "source": {
        "document": "Client decisions",
        "section": "2026-10-09, half bath"
