  "rules": [
    {
      "rule_id": "K01-STAIR-TOP-ARRIVAL",
      "kind": "client",
      "magnitude": "stair_top_receiving_space",
      "operator": "in",
      "value": null,
      "unit": null,
      "parameters": {
        "default": "hall",
        "small_house": "upper_vestibule",
        "max": "family_room",
        "allowed": [
          "hall",
          "upper_vestibule",
          "family_room"
        ],
        "forbidden": [
          "bedroom",
          "primary_suite",
          "flex_room",
          "study",
          "primary_bath",
          "bathroom",
          "walk_in_closet",
          "closet",
          "laundry",
          "laundry_closet"
        ],
        "as_preference": {
          "order_small_house": [
            "upper_vestibule",
            "hall",
            "family_room"
          ],
          "order_default": [
            "hall",
            "upper_vestibule",
            "family_room"
          ],
          "decided": "2026-10-10: the receiving space among the allowed ones is a preference (scored); arriving into a forbidden space is never allowed."
        }
      },
      "text": [
        "The stair never arrives directly into a room upstairs: it arrives into a hall; in small houses into a vestibule; at most into a family room."
      ],
      "source": {
        "document": "Client decisions",
        "section": "2026-10-09, stair arrival"
      },
      "verified": true
    },
    {
      "rule_id": "K02-STAIR-BOTTOM-START",
      "kind": "client",
      "magnitude": "stair_bottom_receiving_space",
      "operator": "in",
      "value": null,
      "unit": null,
      "parameters": {
        "options": [
          {
            "option": "A",
            "label": "vestibulated",
            "receiving": [
              "foyer",
              "hall"
            ]
          },
          {
            "option": "B",
            "label": "living",
            "receiving": [
              "living_room",
              "living_dining",
              "family_room"
            ]
          },
          {
            "option": "C",
            "label": "kitchen",
            "receiving": [
              "kitchen",
              "dining_room",
              "breakfast_nook"
            ]
          }
        ],
        "forbidden": [
          "garage_1car",
          "garage_2car",
          "garage_2car_tandem",
          "bedroom",
          "primary_suite",
          "primary_bath",
          "bathroom",
          "laundry",
          "laundry_closet"
        ]
      },
      "text": [
        "Downstairs the stair starts vestibulated to a circulation, from the living room or, as a third option always available, from the kitchen; never from the garage, a bedroom, a bathroom or the laundry."
      ],
      "source": {
        "document": "Client decisions",
        "section": "2026-10-09, stair start"
      },
      "verified": true
    },
    {
      "rule_id": "K03-UNDER-STAIR-KITCHEN",
      "kind": "client",
      "magnitude": "under_stair_use",
      "operator": "in",
      "value": null,
      "unit": null,
      "parameters": {
        "opens_to": [
          "kitchen",
          "dining_room",
          "breakfast_nook"
        ],
        "uses": [
          "storage",
          "pantry"
        ]
      },
      "text": [
        "If the space under the stair opens toward the kitchen it is storage only, never a half bath."
      ],
      "source": {
        "document": "Client decisions",
        "section": "2026-10-09, under-stair space"
      },
      "verified": true
    },
    {
