      "kind": "client",
      "magnitude": "stair_strategy_preference",
      "operator": "in",
      "value": null,
      "unit": null,
      "parameters": {
        "strategies": {
          "A": "side wall",
          "B": "centre (joint)",
          "C": "interior void between the flights of a U (lit by a window; no skylight)",
          "D": "rear facade band"
        },
        "preference": [
          "B",
          "A",
          "D",
          "C"
        ],
        "chosen_by": "client",
        "fallback": "A",
        "decided": "2026-10-14 (V6.8): the joint first (the stair at the centre of the ground floor and at the edge of the upper floor; a U turned to start and arrive on the hall), the side wall as the fallback; no L stair"
      },
      "text": [
        "Stair placement strategy chosen by the client (never inferred): A side wall, D rear facade, C interior void with skylight, B centre as the last resort. Stage S2 compares the best candidates of each strategy; the preference breaks ties.",
        "2026-10-14 (V6.8, client): B joint first, then A, D, C; L stairs removed."
      ],
      "source": {
        "document": "Client decisions",
        "section": "2026-10-10, stair strategies A-D"
      },
      "verified": true
