{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://municipal-permit-intelligence/spaceplan/contracts/stack_plan/0.2.0",
  "title": "Stack plan per lot (step 6.7)",
  "description": "Levels relative to grade, height budget against the angled envelope plane and the stage each selected area-matrix cell reached (S0 levels and height; S1 stair and plane-limited polygons; S2 upper-floor zoning). Stage S1 adds the optional `s1` block per two-floor cell (additive within contract 0.2.0); stage S1.1 adds the stair core and the rule traces. Stage S2 adds the optional `s2` block per drawn cell: zoning of both floors around the stair core, the A/B/C start portfolio and the client-rule traces (additive within 0.2.0).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "produced_by",
    "input_sha256",
    "meta",
    "lots",
    "cells"
  ],
  "$defs": {
    "status": {
      "enum": [
        "within_plane",
        "plane_governs",
        "exceeds_height"
      ]
    },
    "level": {
      "type": "object",
      "required": [
        "level",
        "kind",
        "finish_floor_ft",
        "gross_sqft",
        "stair_sqft",
        "counts_in_gfa",
        "is_story",
        "counts_in_io"
      ],
      "properties": {
        "level": {
          "type": "integer",
          "minimum": -1
        },
        "kind": {
          "enum": [
            "below",
            "ground",
            "upper"
          ]
        },
        "finish_floor_ft": {
          "type": "number"
        },
        "gross_sqft": {
          "type": "number",
          "minimum": 0
        },
        "stair_sqft": {
          "type": "number",
          "minimum": 0
        },
        "spaces": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "counts_in_gfa": {
          "type": "boolean"
        },
        "is_story": {
          "type": "boolean"
        },
        "counts_in_io": {
          "type": "boolean"
        }
      }
    },
    "height": {
      "type": "object",
      "required": [
        "roof_id",
        "status",
        "plate_ft",
        "top_ft",
        "side_wall",
        "side_inset_ft",
        "front_plane_required",
        "overall_height_ft",
        "overall_limit_ft",
        "headroom_ft"
      ],
      "properties": {
        "roof_id": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "plate_ft": {
          "type": "number"
        },
        "top_ft": {
          "type": "number"
        },
        "side_wall": {
          "enum": [
            "eave",
            "gable",
            "parapet"
          ]
        },
        "side_inset_ft": {
          "type": "number",
          "minimum": 0
        },
        "front_plane_required": {
          "type": "boolean"
        },
        "top_floor_width_ft": {
          "type": "number"
        },
        "top_floor_depth_ft": {
          "type": "number"
        },
        "grade_differential_ft": {
          "type": "number"
        },
        "overall_height_ft": {
          "type": "number"
        },
        "overall_limit_ft": {
          "type": "number"
        },
        "headroom_ft": {
          "type": "number"
        }
      }
    },
    "below_grade": {
      "type": "object",
      "required": [
        "exposure_ft",
        "slope_class",
        "gfa_threshold_ft",
        "story_threshold_ft",
        "counts_in_gfa",
        "is_story",
        "band"
      ],
      "properties": {
        "exposure_ft": {
          "type": "number"
        },
        "slope_class": {
          "enum": [
            "flat",
            "sloped"
          ]
        },
        "gfa_threshold_ft": {
          "type": "number"
        },
        "story_threshold_ft": {
          "type": "number"
        },
        "counts_in_gfa": {
          "type": "boolean"
        },
        "is_story": {
          "type": "boolean"
        },
        "band": {
          "enum": [
            "outside_gfa",
            "gfa_not_story",
            "story"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "polygon": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "enum": [
            "Polygon",
            "MultiPolygon"
          ]
        },
        "coordinates": {
          "type": "array"
        }
      },
      "description": "GeoJSON-like polygon in the lot's world coordinates (as lot_capacity)."
    },
    "s1": {
      "type": "object",
      "description": "Stage S1 of a two-floor cell: drawn ground and upper floors, stand-in garage, stair at the joint, allowed polygon per level (131.0444), roof of the drawn upper floor against the plane, containment and room over the garage (R302.6).",
      "required": [
        "stage",
        "status",
        "next_stage",
        "strategy",
        "warnings"
      ],
      "properties": {
        "stage": {
          "const": "S1"
        },
        "status": {
          "enum": [
            "drawn",
            "ground_not_realized",
            "stair_does_not_fit",
            "upper_not_contained"
          ]
        },
        "next_stage": {
          "enum": [
            "S2",
            null
          ]
        },
        "strategy": {
          "type": [
            "string",
            "null"
          ]
        },
        "steps": {
          "type": [
            "integer",
            "null"
          ]
        },
        "upper_placement": {
          "enum": [
            "rear",
            "front",
            "over_garage",
            "compact"
          ]
        },
        "upper_candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "placement",
              "drawn",
              "stair_fits"
            ],
            "properties": {
              "placement": {
                "type": "string"
              },
              "drawn": {
                "type": "boolean"
              },
              "stair_fits": {
                "type": "boolean"
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "joint_ft": {
                "type": "number"
              },
              "over_garage_sqft": {
                "type": "number"
              },
              "stair_candidates": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "ground": {
          "type": "object",
          "required": [
            "area_sqft",
            "width_ft",
            "depth_ft",
            "garage_sqft",
            "garage_polygon"
          ],
          "properties": {
            "area_sqft": {
              "type": "number"
            },
            "width_ft": {
              "type": "number"
            },
            "depth_ft": {
              "type": "number"
            },
            "garage_sqft": {
              "type": "number"
            },
            "garage_polygon": {
              "$ref": "#/$defs/polygon"
            }
          }
        },
        "levels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "level",
              "wall_top_ft",
              "area_sqft",
              "polygon",
              "allowed_polygon",
              "within_allowed"
            ],
            "properties": {
              "level": {
                "type": "integer"
              },
              "wall_top_ft": {
                "type": "number"
              },
              "area_sqft": {
                "type": "number"
              },
              "polygon": {
                "$ref": "#/$defs/polygon"
              },
              "allowed_polygon": {
                "$ref": "#/$defs/polygon"
              },
              "within_allowed": {
                "type": "boolean"
              }
            }
          }
        },
        "stair": {
          "type": "object",
          "required": [
            "stair_id",
            "risers",
            "riser_in",
            "treads",
            "tread_in",
            "width_ft",
            "length_ft",
            "span_ft",
            "area_sqft",
            "polygon",
            "same_position_all_levels",
            "rules"
          ],
          "properties": {
            "stair_id": {
              "enum": [
                "straight",
                "straight_landing",
                "l_turn",
                "u_turn"
              ]
            },
            "risers": {
              "type": "integer",
              "minimum": 1
            },
            "riser_in": {
              "type": "number"
            },
            "treads": {
              "type": "integer",
              "minimum": 0
            },
            "tread_in": {
              "type": "number"
            },
            "width_ft": {
              "type": "number"
            },
            "landing_ft": {
              "type": "number"
            },
            "length_ft": {
              "type": "number"
            },
            "span_ft": {
              "type": "number"
            },
            "area_sqft": {
              "type": "number"
            },
            "polygon": {
              "$ref": "#/$defs/polygon"
            },
            "run_along_joint": {
              "type": "boolean"
            },
            "offset_from_joint_middle_ft": {
              "type": "number"
            },
            "on_joint": {
              "type": "boolean"
            },
            "same_position_all_levels": {
              "type": "boolean"
            },
            "headroom_ok": {
              "type": "boolean"
            },
            "catalog_target_sqft": {
              "type": "number"
            },
            "area_delta_sqft": {
              "type": "number"
            },
            "rules": {
              "type": "object"
            },
            "net_ground_sqft": {
              "type": "number"
            },
            "net_ground_delta_sqft": {
              "type": "number"
            },
            "max_flight_rise_in": {
              "type": "number"
            }
          }
        },
        "containment": {
          "type": "object",
          "required": [
            "upper_in_ground",
            "levels_within_allowed",
            "over_garage_sqft",
            "room_over_garage"
          ],
          "properties": {
            "upper_in_ground": {
              "type": "boolean"
            },
            "levels_within_allowed": {
              "type": "boolean"
            },
            "over_garage_sqft": {
              "type": "number"
            },
            "room_over_garage": {
              "type": "boolean"
            },
            "garage_separation": {
              "type": [
                "object",
                "null"
              ]
            }
          }
        },
        "roof": {
          "type": "object",
          "required": [
            "default",
            "kept",
            "inset_needed_ft",
            "checks"
          ],
          "properties": {
            "default": {
              "$ref": "#/$defs/status"
            },
            "default_ridge": {
              "type": [
                "string",
                "null"
              ]
            },
            "kept": {
              "enum": [
                "default",
                "rotated",
                "flat",
                null
              ]
            },
            "kept_roof_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "kept_ridge": {
              "type": [
                "string",
                "null"
              ]
            },
            "inset_needed_ft": {
              "type": "number",
              "minimum": 0
            },
            "checks": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "step",
                  "roof_id",
                  "status",
                  "top_ft"
                ],
                "properties": {
                  "step": {
                    "type": "string"
                  },
                  "roof_id": {
                    "type": "string"
                  },
                  "ridge": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "status": {
                    "$ref": "#/$defs/status"
                  },
                  "top_ft": {
                    "type": "number"
                  },
                  "plane_margin_ft": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "inset_needed_ft": {
                    "type": "number"
                  },
                  "governing_edge": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stair_core": {
          "$ref": "#/$defs/stair_core"
        },
        "rule_traces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule_trace"
          }
        }
      }
    },
    "stair_core": {
      "type": "object",
      "description": "Stage S1.1: the stair as the fixed core stage S2 zones around: configuration, footprint, ends with their arrival zones and receiving spaces (client rules K01, K02), the space under the stair and its use per bottom option (K03, K04), the alternatives per configuration and the D/I/N extension (K05).",
      "required": [
        "fixed",
        "stair_id",
        "footprint",
        "bottom_end",
        "top_end",
        "under_stair",
        "alternatives",
        "valid_candidates",
        "relations"
      ],
      "properties": {
        "fixed": {
          "const": true
        },
        "stair_id": {
          "enum": [
            "straight",
            "straight_landing",
            "l_turn",
            "u_turn"
          ]
        },
        "footprint": {
          "$ref": "#/$defs/polygon"
        },
        "bottom_end": {
          "type": "object",
          "required": [
            "edge",
            "zone",
            "receiving"
          ],
          "properties": {
            "edge": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2
            },
            "zone": {
              "$ref": "#/$defs/polygon"
            },
            "receiving": {
              "type": "object"
            },
            "entry_distance_ft": {
              "type": "number"
            }
          }
        },
        "top_end": {
          "type": "object",
          "required": [
            "edge",
            "zone",
            "receiving"
          ],
          "properties": {
            "edge": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2
            },
            "zone": {
              "$ref": "#/$defs/polygon"
            },
            "receiving": {
              "type": "object"
            },
            "entry_distance_ft": {
              "type": "number"
            }
          }
        },
        "under_stair": {
          "type": "object",
          "required": [
            "low_sqft",
            "storage_sqft",
            "half_bath_band_sqft",
            "recovered_sqft",
            "net_ground_sqft",
            "half_bath_fit",
            "access_side",
            "use_default",
            "use_by_bottom_option"
          ],
          "properties": {
            "low_sqft": {
              "type": "number"
            },
            "storage_sqft": {
              "type": "number"
            },
            "half_bath_band_sqft": {
              "type": "number"
            },
            "recovered_sqft": {
              "type": "number"
            },
            "net_ground_sqft": {
              "type": "number"
            },
            "half_bath_fit": {
              "type": "boolean"
            },
            "half_bath": {
              "$ref": "#/$defs/polygon"
            },
            "vestibule": {
              "$ref": "#/$defs/polygon"
            },
            "half_bath_extension_ft": {
              "type": [
                "number",
                "null"
              ]
            },
            "access_side": {
              "enum": [
                "bottom",
                "apart",
                "none"
              ]
            },
            "use_default": {
              "enum": [
                "half_bath",
                "storage",
                "pantry"
              ]
            },
            "use_by_bottom_option": {
              "type": "object",
              "additionalProperties": {
                "enum": [
                  "half_bath",
                  "storage",
                  "pantry"
                ]
              }
            },
            "protection": {
              "type": "object"
            }
          }
        },
        "alternatives": {
          "type": "object"
        },
        "valid_candidates": {
          "type": "integer",
          "minimum": 1
        },
        "relations": {
          "type": "object"
        }
      }
    },
    "rule_trace": {
      "type": "object",
      "required": [
        "rule_id",
        "kind",
        "result",
        "status",
        "source"
      ],
      "properties": {
        "rule_id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "normative",
            "client"
          ]
        },
        "result": {
          "enum": [
            "pass",
            "fail",
            "deferred_to_S2",
            "deferred_to_S2.1",
            "not_evaluated"
          ]
        },
        "status": {
          "enum": [
            "verified",
            "provisional"
          ]
        },
        "source": {
          "type": "string"
        },
        "detail": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "s2_unit": {
      "type": "object",
      "required": [
        "unit_id",
        "zone",
        "space_ids",
        "target_sqft",
        "area_sqft",
        "polygon"
      ],
      "properties": {
        "unit_id": {
          "type": "string"
        },
        "zone": {
          "type": "string"
        },
        "space_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "target_sqft": {
          "type": "number",
          "minimum": 0
        },
        "area_sqft": {
          "type": "number",
          "minimum": 0
        },
        "width_ft": {
          "type": "number"
        },
        "depth_ft": {
          "type": "number"
        },
        "polygon": {
          "oneOf": [
            {
              "$ref": "#/$defs/polygon"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "s2_floor": {
      "type": "object",
      "required": [
        "level",
        "variant",
        "units",
        "topology",
        "landing_unit",
        "score",
        "score_parts",
        "search"
      ],
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 0
        },
        "variant": {
          "type": "string"
        },
        "units": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/s2_unit"
          }
        },
        "topology": {
          "type": "object",
          "required": [
            "axis",
            "bands"
          ],
          "properties": {
            "axis": {
              "enum": [
                "x",
                "y"
              ]
            },
            "bands": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "landing_unit": {
          "type": "string"
        },
        "landing_share": {
          "type": "number"
        },
        "entry_unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "entry_fallback": {
          "type": "boolean"
        },
        "links": {
          "type": "array"
        },
        "score": {
          "type": "number"
        },
        "score_parts": {
          "type": "object"
        },
        "matrix_deferred": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scale": {
          "type": "number"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "search": {
          "type": "object"
        },
        "alternatives": {
          "type": "array"
        }
      }
    },
    "s2_option": {
      "type": "object",
      "required": [
        "option",
        "label",
        "receiving",
        "under_stair_use",
        "feasible"
      ],
      "properties": {
        "option": {
          "enum": [
            "A",
            "B",
            "C"
          ]
        },
        "label": {
          "type": "string"
        },
        "receiving": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "under_stair_use": {
          "type": "string"
        },
        "feasible": {
          "type": "boolean"
        },
        "variant": {
          "type": "string"
        },
        "half_bath": {
          "enum": [
            "under_stair",
            "relocated",
            null
          ]
        },
        "score": {
          "type": "number"
        },
        "vertical": {
          "type": "object"
        },
        "ground": {
          "$ref": "#/$defs/s2_floor"
        },
        "reason": {
          "type": "string"
        },
        "ground_search": {
          "type": "object"
        }
      }
    },
    "s2": {
      "type": "object",
      "required": [
        "stage",
        "status",
        "next_stage",
        "warnings"
      ],
      "description": "Stage S2: zoning of both floors around the stair core. status zoned -> next_stage S2.1 (space level, planned).",
      "properties": {
        "stage": {
          "const": "S2"
        },
        "status": {
          "enum": [
            "zoned",
            "upper_not_zoned",
            "ground_not_zoned",
            "not_zoned",
            "no_space_split"
          ]
        },
        "next_stage": {
          "enum": [
            "S2.1",
            null
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "arrival": {
          "type": "object",
          "required": [
            "receiving"
          ],
          "properties": {
            "receiving": {
              "enum": [
                "family_room",
                "upper_vestibule",
                "hall"
              ]
            },
            "upper_rooms": {
              "type": "integer"
            },
            "family_room_upstairs": {
              "type": "boolean"
            }
          }
        },
        "preferred_option": {
          "enum": [
            "A",
            "B",
            "C"
          ]
        },
        "chosen_option": {
          "enum": [
            "A",
            "B",
            "C",
            null
          ]
        },
        "feasible_options": {
          "type": "array",
          "items": {
            "enum": [
              "A",
              "B",
              "C"
            ]
          }
        },
        "upper": {
          "$ref": "#/$defs/s2_floor"
        },
        "upper_search": {
          "type": "object"
        },
        "score": {
          "type": "number"
        },
        "vertical": {
          "type": "object"
        },
        "options": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/s2_option"
          }
        },
        "matrix_overrides": {
          "type": "array"
        },
        "rule_traces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule_trace"
          }
        },
        "backtrack": {
          "type": "object",
          "required": [
            "tried",
            "placement",
            "redrawn"
          ],
          "properties": {
            "tried": {
              "type": "array"
            },
            "placement": {
              "type": "string"
            },
            "redrawn": {
              "type": "boolean"
            },
            "stair_id": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "properties": {
    "contract": {
      "const": "stack_plan"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "produced_by": {
      "const": "stacking"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 (canonical JSON) of the inputs the producer read (the area_matrix and lot_capacity contracts and the selection mode)."
    },
    "brief_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Brief the contract belongs to (informative; null for a multi-lot plan)."
    },
    "consumers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Informative: modules expected to read it (viz, pipeline)."
    },
    "meta": {
      "type": "object",
      "required": [
        "step",
        "stage",
        "selection_mode",
        "selection",
        "vertical_ruleset",
        "vertical_ruleset_version",
        "stacking_catalog_version",
        "households",
        "lots"
      ],
      "properties": {
        "step": {
          "type": "string"
        },
        "stage": {
          "enum": [
            "S0",
            "S1",
            "S2"
          ]
        },
        "selection_mode": {
          "type": "string"
        },
        "selection": {
          "type": "object"
        },
        "vertical_ruleset": {
          "type": "string"
        },
        "vertical_ruleset_version": {
          "type": "string"
        },
        "stacking_catalog_version": {
          "type": "string"
        },
        "households": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "lots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "lot_id",
          "lot_width_ft",
          "height_envelope",
          "floors_by_height",
          "slope_class",
          "below_grade_probe",
          "summary"
        ],
        "properties": {
          "lot_id": {
            "type": "string"
          },
          "lot_width_ft": {
            "type": "number"
          },
          "side_setback_ft": {
            "type": "number"
          },
          "height_envelope": {
            "type": "object",
            "required": [
              "plane_start_ft",
              "overall_max_ft",
              "angle_deg",
              "front_trigger_ft",
              "status"
            ],
            "properties": {
              "plane_start_ft": {
                "type": "number"
              },
              "overall_max_ft": {
                "type": "number"
              },
              "angle_deg": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "front_trigger_ft": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "status": {
                "enum": [
                  "verified",
                  "provisional"
                ]
              }
            }
          },
          "floors_by_height": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "slope_class": {
            "enum": [
              "flat",
              "sloped"
            ]
          },
          "below_grade_probe": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/below_grade"
            }
          },
          "summary": {
            "type": "object"
          },
          "plan": {
            "type": "object",
            "required": [
              "lot_polygon",
              "envelope_polygon"
            ],
            "description": "Stage S1: lot and envelope polygons (world coordinates, from lot_capacity) so the stacked plans are drawn from this contract alone.",
            "properties": {
              "lot_polygon": {
                "$ref": "#/$defs/polygon"
              },
              "envelope_polygon": {
                "$ref": "#/$defs/polygon"
              }
            }
          }
        }
      }
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "lot_id",
          "household_id",
          "profile",
          "scheme_id",
          "floors",
          "rank",
          "selection",
          "levels",
          "height",
          "default_roof",
          "status",
          "next_stage",
          "warnings"
        ],
        "properties": {
          "lot_id": {
            "type": "string"
          },
          "household_id": {
            "type": "string"
          },
          "profile": {
            "type": "string"
          },
          "scheme_id": {
            "type": "string"
          },
          "floors": {
            "type": "integer",
            "minimum": 1
          },
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "selection": {
            "type": "string"
          },
          "levels": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/level"
            }
          },
          "height": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/height"
            }
          },
          "default_roof": {
            "type": "string"
          },
          "status": {
            "$ref": "#/$defs/status"
          },
          "next_stage": {
            "enum": [
              "S1",
              "S2",
              "S2.1",
              null
            ]
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "s1": {
            "$ref": "#/$defs/s1"
          },
          "s2": {
            "$ref": "#/$defs/s2"
          }
        }
      }
    },
    "figures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
