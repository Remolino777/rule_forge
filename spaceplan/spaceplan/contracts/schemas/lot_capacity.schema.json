{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://municipal-permit-intelligence/spaceplan/contracts/lot_capacity/0.2.0",
  "title": "Lot capacity (layer 0)",
  "description": "Lot, boundaries, setbacks and rule variants, envelope, FAR, coverage, realizable capacity per strategy, lot conformity and sensitivity. Blocks reuse the package schema definitions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "produced_by",
    "input_sha256",
    "lot",
    "scope",
    "lot_metrics",
    "boundaries",
    "rule_variants",
    "lot_conformity",
    "capacity",
    "realizable_capacity",
    "sensitivity"
  ],
  "properties": {
    "contract": {
      "const": "lot_capacity"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "produced_by": {
      "const": "lotcap"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 (canonical JSON) of the inputs the producer read (brief or upstream contracts), for traceability."
    },
    "brief_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Brief the contract belongs to (informative)."
    },
    "consumers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Informative: modules expected to read it (site, zoning, areas, viz)."
    },
    "lot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "polygon"
      ],
      "properties": {
        "polygon": {
          "$ref": "#/$defs/geojson_polygon"
        },
        "flag": {
          "type": [
            "object",
            "null"
          ],
          "description": "Flag-lot reading (body and access strip), provisional."
        },
        "lot_block": {
          "$ref": "https://municipal-permit-intelligence/spaceplan/brief/0.2#/properties/lot",
          "description": "Brief lot block the module planned on (the body of a flag lot); viz rebuilds the lot geometry from it."
        }
      }
    },
    "scope": {
      "$ref": "https://municipal-permit-intelligence/spaceplan/package/0.6#/properties/scope"
    },
    "lot_metrics": {
      "$ref": "https://municipal-permit-intelligence/spaceplan/package/0.6#/properties/lot_metrics"
    },
    "boundaries": {
      "$ref": "https://municipal-permit-intelligence/spaceplan/package/0.6#/properties/boundaries"
    },
    "rule_variants": {
      "$ref": "https://municipal-permit-intelligence/spaceplan/package/0.6#/properties/rule_variants"
    },
    "lot_conformity": {
      "$ref": "https://municipal-permit-intelligence/spaceplan/package/0.6#/properties/lot_conformity"
    },
    "capacity": {
      "$ref": "https://municipal-permit-intelligence/spaceplan/package/0.6#/properties/capacity"
    },
    "realizable_capacity": {
      "$ref": "https://municipal-permit-intelligence/spaceplan/package/0.6#/properties/realizable_capacity"
    },
    "sensitivity": {
      "$ref": "https://municipal-permit-intelligence/spaceplan/package/0.6#/properties/sensitivity"
    },
    "warnings": {
      "$ref": "https://municipal-permit-intelligence/spaceplan/package/0.6#/properties/warnings"
    },
    "terrain": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "https://municipal-permit-intelligence/spaceplan/brief/0.2#/properties/terrain"
        }
      ],
      "description": "Brief terrain block (slope for the quantity sheets)."
    },
    "realization_strategy": {
      "$ref": "https://municipal-permit-intelligence/spaceplan/package/0.6#/properties/meta/properties/realization_strategy",
      "description": "Footprint realization strategy selected by lotcap."
    }
  },
  "$defs": {
    "geojson_polygon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "coordinates"
      ],
      "description": "GeoJSON Polygon in the local lot frame (feet), exterior ring closed.",
      "properties": {
        "type": {
          "const": "Polygon"
        },
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 4,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            }
          }
        }
      }
    }
  }
}
