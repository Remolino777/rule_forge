{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://municipal-permit-intelligence/spaceplan/contracts/program_portfolio/0.2.0",
  "title": "Program portfolio",
  "description": "Expansion curve, the five profiles (minimum, optimum, maximum, accessible, staged) and the ceilings.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "produced_by",
    "input_sha256",
    "reading",
    "model",
    "ceilings",
    "household",
    "curve",
    "profiles"
  ],
  "properties": {
    "contract": {
      "const": "program_portfolio"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "produced_by": {
      "const": "profiles"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 (canonical JSON) of the inputs the producer read (brief or upstream contracts), for traceability."
    },
    "consumers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Informative: modules expected to read it (areas, viz)."
    },
    "brief_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "reading": {
      "enum": [
        "lot",
        "reference_dwelling"
      ]
    },
    "model": {
      "enum": [
        "base",
        "weighted",
        "shape"
      ]
    },
    "legend": {
      "type": "string"
    },
    "ceilings": {
      "type": "object",
      "required": [
        "far_sqft",
        "one_floor_max_sqft",
        "budget_fraction",
        "governing"
      ],
      "properties": {
        "far_sqft": {
          "type": [
            "number",
            "null"
          ]
        },
        "one_floor_max_sqft": {
          "type": [
            "number",
            "null"
          ]
        },
        "budget_fraction": {
          "type": [
            "number",
            "null"
          ]
        },
        "budget": {
          "type": [
            "object",
            "null"
          ]
        },
        "governing": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "household": {
      "type": "object",
      "required": [
        "archetype_id"
      ],
      "properties": {
        "archetype_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "quality_note": {
      "type": "string"
    },
    "curve": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "step",
          "move",
          "gross_area_sqft",
          "index",
          "quality"
        ]
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum",
        "optimum",
        "maximum",
        "accessible",
        "staged"
      ],
      "properties": {
        "minimum": {
          "type": "object",
          "required": [
            "profile",
            "program",
            "gross_area_sqft",
            "index",
            "quality",
            "feasibility",
            "within_ceilings"
          ],
          "properties": {
            "profile": {
              "type": "string"
            },
            "program": {
              "$ref": "https://municipal-permit-intelligence/spaceplan/brief/0.2#/properties/program"
            },
            "gross_area_sqft": {
              "type": "number"
            },
            "index": {
              "type": "number"
            },
            "quality": {
              "type": "number"
            },
            "feasibility": {
              "type": "string"
            },
            "within_ceilings": {
              "type": "boolean"
            },
            "next_stage_coverage": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "optimum": {
          "type": "object",
          "required": [
            "profile",
            "program",
            "gross_area_sqft",
            "index",
            "quality",
            "feasibility",
            "within_ceilings"
          ],
          "properties": {
            "profile": {
              "type": "string"
            },
            "program": {
              "$ref": "https://municipal-permit-intelligence/spaceplan/brief/0.2#/properties/program"
            },
            "gross_area_sqft": {
              "type": "number"
            },
            "index": {
              "type": "number"
            },
            "quality": {
              "type": "number"
            },
            "feasibility": {
              "type": "string"
            },
            "within_ceilings": {
              "type": "boolean"
            },
            "next_stage_coverage": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "maximum": {
          "type": "object",
          "required": [
            "profile",
            "program",
            "gross_area_sqft",
            "index",
            "quality",
            "feasibility",
            "within_ceilings"
          ],
          "properties": {
            "profile": {
              "type": "string"
            },
            "program": {
              "$ref": "https://municipal-permit-intelligence/spaceplan/brief/0.2#/properties/program"
            },
            "gross_area_sqft": {
              "type": "number"
            },
            "index": {
              "type": "number"
            },
            "quality": {
              "type": "number"
            },
            "feasibility": {
              "type": "string"
            },
            "within_ceilings": {
              "type": "boolean"
            },
            "next_stage_coverage": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "accessible": {
          "type": "object",
          "required": [
            "profile",
            "program",
            "gross_area_sqft",
            "index",
            "quality",
            "feasibility",
            "within_ceilings"
          ],
          "properties": {
            "profile": {
              "type": "string"
            },
            "program": {
              "$ref": "https://municipal-permit-intelligence/spaceplan/brief/0.2#/properties/program"
            },
            "gross_area_sqft": {
              "type": "number"
            },
            "index": {
              "type": "number"
            },
            "quality": {
              "type": "number"
            },
            "feasibility": {
              "type": "string"
            },
            "within_ceilings": {
              "type": "boolean"
            },
            "next_stage_coverage": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "staged": {
          "type": "object",
          "required": [
            "profile",
            "today",
            "final",
            "index_today",
            "index_later",
            "index_total"
          ],
          "properties": {
            "today": {
              "type": "object",
              "required": [
                "program"
              ],
              "properties": {
                "program": {
                  "$ref": "https://municipal-permit-intelligence/spaceplan/brief/0.2#/properties/program"
                }
              }
            },
            "final": {
              "type": "object",
              "required": [
                "program"
              ],
              "properties": {
                "program": {
                  "$ref": "https://municipal-permit-intelligence/spaceplan/brief/0.2#/properties/program"
                }
              }
            },
            "index_today": {
              "type": "number"
            },
            "index_later": {
              "type": "number"
            },
            "index_total": {
              "type": "number"
            }
          }
        }
      }
    },
    "sheets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
