{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://municipal-permit-intelligence/spaceplan/contracts/cost_report/0.2.0",
  "title": "Relative cost report",
  "description": "Quantity sheets, relative index per cost model, budget and tornado. Relative index only, no money.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "produced_by",
    "input_sha256",
    "cost"
  ],
  "properties": {
    "contract": {
      "const": "cost_report"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "produced_by": {
      "const": "cost"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 (canonical JSON) of the inputs the producer read (brief or upstream contracts), for traceability."
    },
    "brief_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Brief the contract belongs to (informative)."
    },
    "consumers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Informative: modules expected to read it (profiles, areas, pipeline)."
    },
    "cost": {
      "$ref": "https://municipal-permit-intelligence/spaceplan/package/0.6#/properties/cost"
    }
  }
}
